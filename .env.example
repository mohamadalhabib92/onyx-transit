# Copiez ce fichier en .env et remplacez les placeholders. Ne commitez jamais .env.
# Valeurs PUBLIQUES uniquement (EXPO_PUBLIC_* est embarqué dans l'app).
# Ne jamais définir EXPO_PUBLIC_EXAMPLE_EN (ancienne variable de test, ignorée par l'app).

EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
EXPO_PUBLIC_API_BASE_URL=YOUR_API_BASE_URL
EXPO_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN

# Textes affichés tels quels tant qu'ils commencent par YOUR_. Aucune valeur inventée.
EXPO_PUBLIC_COMPANY_LEGAL_NAME=YOUR_COMPANY_LEGAL_NAME
EXPO_PUBLIC_VAT_NUMBER=YOUR_VAT_NUMBER
EXPO_PUBLIC_DPO_EMAIL=YOUR_DPO_EMAIL
EXPO_PUBLIC_SUPPORT_EMAIL=YOUR_SUPPORT_EMAIL
EXPO_PUBLIC_TARIFF_TABLE=YOUR_TARIFF_TABLE
EXPO_PUBLIC_FREE_CANCEL_HOURS=YOUR_FREE_CANCEL_HOURS
EXPO_PUBLIC_AIRPORT_FREE_WAIT_MIN=YOUR_AIRPORT_FREE_WAIT_MIN
# Minutes de conduite maximum, nombre seul. YOUR_* = seuil non appliqué (à valider).
EXPO_PUBLIC_OTR2_LIMITS=YOUR_OTR2_LIMITS
EXPO_PUBLIC_OPERATING_MODEL=YOUR_OPERATING_MODEL
EXPO_PUBLIC_LOCATION_RETENTION_DAYS=YOUR_LOCATION_RETENTION_DAYS
EXPO_PUBLIC_MAPS_PROVIDER=YOUR_MAPS_PROVIDER

# Flags. Toute valeur autre que true laisse la fonction désactivée.
EXPO_PUBLIC_CITY_PARIS=false
EXPO_PUBLIC_CITY_CASABLANCA=false
EXPO_PUBLIC_FEATURE_TWINT=false
EXPO_PUBLIC_FEATURE_AI_DISPATCH=false

# Côté SERVEUR uniquement (jamais dans l'app, jamais en EXPO_PUBLIC_) :
# STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
# YOUR_MAPS_API_KEY=YOUR_MAPS_API_KEY
# YOUR_SWISS_IBAN=YOUR_SWISS_IBAN

# Build : garder EXPO_NO_CAPABILITY_SYNC=1 (voir eas.json). Ne pas y mettre de clé ASC ni de chemin .p8.
