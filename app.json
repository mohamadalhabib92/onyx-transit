{
  "expo": {
    "name": "Onyx Transit",
    "slug": "onyx-transit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "onyxtransit",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0D",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ch.mohamadba.onyxtransit",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Onyx Transit utilise votre position pour pré-remplir le lieu de prise en charge. Elle reste sur votre appareil.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "fr",
        "NSMotionUsageDescription": "Cette app n'utilise pas les données de mouvement ; cette mention est requise par le module de localisation.",
        "NSLocationTemporaryUsageDescriptionDictionary": {
          "ExpoLocationFullAccuracy": "La position précise permet un résultat plus exact."
        }
      },
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "ch.mohamadba.onyxtransit",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Onyx Transit",
      "shortName": "Onyx",
      "themeColor": "#0B0B0D",
      "backgroundColor": "#0B0B0D",
      "lang": "fr"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Onyx Transit utilise votre position pour pré-remplir le lieu de prise en charge. Elle reste sur votre appareil.",
          "locationAlwaysAndWhenInUsePermission": "Onyx Transit utilise votre position pour pré-remplir le lieu de prise en charge. Elle reste sur votre appareil.",
          "locationAlwaysPermission": "Onyx Transit utilise votre position pour pré-remplir le lieu de prise en charge. Elle reste sur votre appareil.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/onyx-transit"
    },
    "owner": "habib548",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bbb2faed-fd86-4567-b84c-26c32bfea811"
      }
    }
  }
}
